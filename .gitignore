# The engine.  outSPOKEN and MacinTalk are not ours to distribute -- see
# THIRD_PARTY_LICENSES.md.  Every extracted resource is a .bin, so the rule is
# blunt on purpose: nothing binary gets committed by accident.
*.bin
rom/
addon/synthDrivers/outspoken_rom/

# Musashi is vendored at a pinned commit (see THIRD_PARTY_LICENSES.md).  Only
# the parts we compile are tracked: m68kmake generates m68kops.* at build time,
# and upstream's example and test trees are not ours to carry.
third_party/musashi/m68kops.c
third_party/musashi/m68kops.h
third_party/musashi/example/
third_party/musashi/test/

# Build output
build/
*.dll
*.exe
*.obj
*.lib
*.exp
*.pdb
*.log

# Audio captured while testing
*.wav
*.aiff

__pycache__/
*.pyc
.venv/
*.nvda-addon

# Another session's git worktrees, when it works beside this checkout.
.claude/worktrees/
